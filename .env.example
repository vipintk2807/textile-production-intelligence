# Example environment variables. This file is NOT read automatically.
# In Windows CMD set them for the current window, for example:
#   set DJANGO_TIME_ZONE=Asia/Kolkata
# Never commit real secrets.

# Local use: leave unset (debug on, insecure dev key, localhost only).
# Anything else: set DJANGO_DEBUG=0 and provide a long random DJANGO_SECRET_KEY.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Kolkata
# DJANGO_DB_PATH=C:\tpi-data\db.sqlite3
# DJANGO_SECURE_COOKIES=1
